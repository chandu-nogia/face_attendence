PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/face_attendance_pro

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional in dev — falls back to in-memory cache if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (face enrollment photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Face matching
FACE_MATCH_THRESHOLD=0.85

# Cron schedules (server local time)
AUTO_ABSENT_CRON=0 18 * * 1-5
MISSING_CHECKOUT_CRON=0 17 * * 1-5

# CORS
CORS_ORIGIN=*

# Late threshold (minutes after school start)
SCHOOL_START_HOUR=8
SCHOOL_START_MINUTE=0
LATE_AFTER_MINUTES=15
